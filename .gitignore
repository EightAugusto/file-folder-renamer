# Compiled binaries and local executables
# Go builds executables with no extension on Linux/macOS and .exe on Windows
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries generated by 'go test -c'
*.test

# Output files from test coverage and profiling
*.out
*.coverprofile
coverage.txt
profile.cov

# Go workspace files (used for local multi-module development)
go.work
go.work.sum

# Dependency directories
# Only un-comment this if you explicitly use and want to ignore the vendor folder
# vendor/

# Local environment variables
.env
.env.local

# IDE and text editor files (Optional but highly recommended)
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# MacOS Specific Files
.DS_Store

# Application
/bin
/build/.cache/
/build/dists/*
!/build/dists/.gitkeep
